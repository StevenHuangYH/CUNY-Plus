{
  "name": "cuny-plus",
  "displayName": "CUNY Plus",
  "version": "0.1.1",
  "description": "CUNY Plus & Utilities",
  "author": "Steven Huang",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulator": "node scripts/serve-fixture.mjs"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "0.0.258",
    "@types/node": "^22.20.4",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^26.1.0",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^3.2.7"
  },
  "manifest": {
    "host_permissions": [
      "https://*.cuny.edu/*",
      "https://www.ratemyprofessors.com/*"
    ],
    "permissions": [
      "storage"
    ]
  }
}
